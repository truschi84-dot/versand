{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      ".vscode/**",
      "deploy.config.json",
      "deploy.config.example.json",
      "server.js",
      "control test.html",
      "test-checklist.html",
      "checklistearbeit/**",
      "checklistearbeit.html",
      "Checkliste.html",
      "ANDROID_*.md",
      "OTA_UPDATE.md",
      "WAS-DU-NOCH-TUN-MUSST.md",
      "app-config.example.json",
      "app-shell.json",
      "IPHONE_SETUP.md",
      "HYBRID_UPDATE.md",
      "UPDATE_HOSTING_ALTERNATIVEN.md",
      "FIREBASE_OTA_EINRICHTUNG.md",
      "TEST_WLAN_UPDATE.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
